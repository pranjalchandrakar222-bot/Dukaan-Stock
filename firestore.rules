rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads/writes unless explicitly matched below
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isOptionalStr(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptionalNum(data, key) {
      return !(key in data) || data[key] is number;
    }

    function isOptionalNonNegNum(data, key) {
      return !(key in data) || (data[key] is number && data[key] >= 0);
    }

    function isOptionalCounter(data, key) {
      return !(key in data) || (data[key] is int && data[key] >= 1);
    }

    function isOptionalBool(data, key) {
      return !(key in data) || data[key] is bool;
    }

    function isValidProfile(data, userId) {
      return data.userId == userId &&
             data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 120 &&
             isOptionalStr(data, 'phone', 40) &&
             isOptionalStr(data, 'email', 120) &&
             isOptionalStr(data, 'gstin', 30) &&
             isOptionalStr(data, 'address', 300) &&
             isOptionalStr(data, 'stateName', 80) &&
             data.currencySymbol is string && data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 5 &&
             isOptionalStr(data, 'invoicePrefix', 20) &&
             data.nextInvoiceNumber is int && data.nextInvoiceNumber >= 1 &&
             isOptionalCounter(data, 'nextPurchaseNumber') &&
             isOptionalCounter(data, 'nextEstimateNumber') &&
             isOptionalCounter(data, 'nextSaleOrderNumber') &&
             isOptionalCounter(data, 'nextChallanNumber') &&
             isOptionalCounter(data, 'nextCreditNoteNumber') &&
             isOptionalCounter(data, 'nextDebitNoteNumber') &&
             isOptionalCounter(data, 'nextPaymentNumber') &&
             isOptionalCounter(data, 'nextExpenseNumber') &&
             isOptionalCounter(data, 'nextCommissionPayoutNumber') &&
             isOptionalBool(data, 'useFinancialYearPrefix') &&
             isOptionalStr(data, 'upiId', 100) &&
             isOptionalStr(data, 'bankDetails', 300) &&
             isOptionalStr(data, 'invoiceTerms', 400) &&
             data.themeStyle in ['DYNAMIC', 'COBALT', 'EMERALD', 'TERRACOTTA', 'SLATE'] &&
             data.stopNegativeStock is bool &&
             data.roundOffTotal is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidParty(data, userId) {
      return data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.partyType in ['CUSTOMER', 'SUPPLIER', 'BOTH'] &&
             isOptionalStr(data, 'phone', 40) &&
             isOptionalStr(data, 'email', 120) &&
             isOptionalStr(data, 'gstin', 30) &&
             isOptionalStr(data, 'stateName', 80) &&
             isOptionalStr(data, 'billingAddress', 300) &&
             isOptionalStr(data, 'shippingAddress', 300) &&
             data.openingBalance is number &&
             data.currentBalance is number &&
             isOptionalStr(data, 'defaultAgentId', 128) &&
             isOptionalBool(data, 'isActive') &&
             isOptionalStr(data, 'notes', 500) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidItem(data, userId) {
      return data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.itemType in ['PRODUCT', 'SERVICE'] &&
             isOptionalStr(data, 'hsnSac', 30) &&
             isOptionalStr(data, 'itemCode', 40) &&
             isOptionalStr(data, 'category', 80) &&
             data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 20 &&
             data.salePrice is number && data.salePrice >= 0 &&
             isOptionalBool(data, 'salePriceWithTax') &&
             isOptionalNonNegNum(data, 'wholesalePrice') &&
             data.purchasePrice is number && data.purchasePrice >= 0 &&
             (!('discountPercent' in data) || (data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 100)) &&
             data.taxRatePercent is number && data.taxRatePercent >= 0 && data.taxRatePercent <= 100 &&
             (!('commissionPercent' in data) || (data.commissionPercent is number && data.commissionPercent >= 0 && data.commissionPercent <= 100)) &&
             isOptionalNum(data, 'openingStock') &&
             data.currentStock is number &&
             isOptionalNonNegNum(data, 'minStockLevel') &&
             isOptionalStr(data, 'location', 120) &&
             isOptionalBool(data, 'isActive') &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAccount(data, userId) {
      return data.userId == userId &&
             data.accountName is string && data.accountName.size() >= 1 && data.accountName.size() <= 100 &&
             data.accountType in ['CASH', 'BANK', 'UPI'] &&
             isOptionalStr(data, 'bankName', 100) &&
             isOptionalStr(data, 'accountNumber', 40) &&
             isOptionalStr(data, 'ifscCode', 20) &&
             isOptionalStr(data, 'upiId', 100) &&
             data.openingBalance is number &&
             data.currentBalance is number &&
             isOptionalBool(data, 'isActive') &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAgent(data, userId) {
      return data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.agentType in ['AGENT', 'MISTRI', 'SALESMAN', 'ARCHITECT', 'CONTRACTOR', 'REFERRAL'] &&
             isOptionalStr(data, 'phone', 40) &&
             isOptionalStr(data, 'cityArea', 100) &&
             isOptionalStr(data, 'upiId', 100) &&
             isOptionalStr(data, 'bankDetails', 300) &&
             isOptionalNonNegNum(data, 'defaultPercent') &&
             isOptionalNonNegNum(data, 'defaultPerUnitAmount') &&
             (!('defaultBasis' in data) || data.defaultBasis in ['TAXABLE', 'TOTAL', 'PROFIT', 'PER_UNIT']) &&
             (!('defaultTrigger' in data) || data.defaultTrigger in ['ON_INVOICE', 'ON_COLLECTION']) &&
             data.openingBalance is number &&
             data.currentBalance is number &&
             isOptionalNum(data, 'totalEarned') &&
             isOptionalNum(data, 'totalPaid') &&
             isOptionalBool(data, 'isActive') &&
             isOptionalStr(data, 'notes', 500) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTransaction(data, userId) {
      return data.userId == userId &&
             data.txType in [
               'SALE', 'PAYMENT_IN', 'ESTIMATE', 'SALE_ORDER', 'DELIVERY_CHALLAN',
               'CREDIT_NOTE', 'PURCHASE', 'PAYMENT_OUT', 'EXPENSE', 'PURCHASE_ORDER',
               'DEBIT_NOTE', 'COMMISSION_PAYOUT', 'CASH_TRANSFER', 'CASH_ADJUSTMENT', 'STOCK_ADJUSTMENT'
             ] &&
             data.refNumber is string && data.refNumber.size() <= 40 &&
             data.dateMillis is int && data.dateMillis >= 0 &&
             (!('dueDateMillis' in data) || (data.dueDateMillis is int && data.dueDateMillis >= 0)) &&
             isOptionalStr(data, 'partyId', 128) &&
             isOptionalStr(data, 'partyName', 120) &&
             isOptionalStr(data, 'placeOfSupply', 80) &&
             isOptionalBool(data, 'isInterState') &&
             isOptionalStr(data, 'category', 80) &&
             (!('paymentMode' in data) || data.paymentMode in ['CASH', 'UPI', 'BANK_TRANSFER', 'CARD', 'CHEQUE']) &&
             isOptionalStr(data, 'accountId', 128) &&
             isOptionalStr(data, 'toAccountId', 128) &&
             isOptionalStr(data, 'linkedTxId', 128) &&
             (!('lineItems' in data) || (data.lineItems is list && data.lineItems.size() <= 100)) &&
             isOptionalNum(data, 'subtotal') &&
             isOptionalNum(data, 'discountAmount') &&
             isOptionalNum(data, 'billDiscountAmount') &&
             isOptionalStr(data, 'extraChargesLabel', 80) &&
             isOptionalNum(data, 'extraChargesAmount') &&
             isOptionalNum(data, 'cgstAmount') &&
             isOptionalNum(data, 'sgstAmount') &&
             isOptionalNum(data, 'igstAmount') &&
             isOptionalNum(data, 'taxAmount') &&
             isOptionalNum(data, 'roundOffAmount') &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.paidAmount is number && data.paidAmount >= 0 &&
             data.balanceAmount is number && data.balanceAmount >= 0 &&
             data.status in ['PAID', 'PARTIAL', 'UNPAID', 'OPEN', 'CONVERTED', 'CANCELLED'] &&
             isOptionalStr(data, 'agentId', 128) &&
             isOptionalStr(data, 'agentName', 120) &&
             (!('commissionBasis' in data) || data.commissionBasis in ['TAXABLE', 'TOTAL', 'PROFIT', 'PER_UNIT']) &&
             (!('commissionTrigger' in data) || data.commissionTrigger in ['ON_INVOICE', 'ON_COLLECTION']) &&
             (!('commissionStatus' in data) || data.commissionStatus in ['NONE', 'ACCRUED', 'PENDING_COLLECTION', 'PARTIAL', 'PAID', 'REVERSED']) &&
             isOptionalNonNegNum(data, 'commissionRatePercent') &&
             isOptionalNonNegNum(data, 'commissionTotalAmount') &&
             isOptionalNonNegNum(data, 'commissionAccruedAmount') &&
             (!('commissionSplits' in data) || (data.commissionSplits is list && data.commissionSplits.size() <= 10)) &&
             isOptionalNonNegNum(data, 'tdsPercent') &&
             isOptionalNonNegNum(data, 'tdsAmount') &&
             isOptionalStr(data, 'cancelReason', 300) &&
             (!('cancelledAtMillis' in data) || (data.cancelledAtMillis is int && data.cancelledAtMillis >= 0)) &&
             isOptionalStr(data, 'notes', 500) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    match /users/{userId} {
      match /settings/{settingId} {
        allow get: if isOwner(userId) && isValidId(settingId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         settingId == 'profile' &&
                         incoming().keys().hasAll([
                           'userId', 'businessName', 'currencySymbol', 'nextInvoiceNumber',
                           'themeStyle', 'stopNegativeStock', 'roundOffTotal', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'businessName', 'phone', 'email', 'gstin', 'address', 'stateName',
                           'currencySymbol', 'invoicePrefix', 'nextInvoiceNumber',
                           'nextPurchaseNumber', 'nextEstimateNumber', 'nextSaleOrderNumber',
                           'nextChallanNumber', 'nextCreditNoteNumber', 'nextDebitNoteNumber',
                           'nextPaymentNumber', 'nextExpenseNumber', 'nextCommissionPayoutNumber',
                           'useFinancialYearPrefix', 'upiId', 'bankDetails',
                           'invoiceTerms', 'themeStyle', 'stopNegativeStock', 'roundOffTotal',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidProfile(incoming(), userId);
        allow update: if isOwner(userId) &&
                         settingId == 'profile' &&
                         isValidProfile(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt && (
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'businessName', 'phone', 'email', 'gstin', 'address', 'stateName',
                             'currencySymbol', 'invoicePrefix', 'nextInvoiceNumber',
                             'nextPurchaseNumber', 'nextEstimateNumber', 'nextSaleOrderNumber',
                             'nextChallanNumber', 'nextCreditNoteNumber', 'nextDebitNoteNumber',
                             'nextPaymentNumber', 'nextExpenseNumber', 'nextCommissionPayoutNumber',
                             'useFinancialYearPrefix', 'upiId', 'bankDetails',
                             'invoiceTerms', 'themeStyle', 'stopNegativeStock', 'roundOffTotal', 'updatedAt'
                           ]) ||
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'nextInvoiceNumber', 'nextPurchaseNumber', 'nextEstimateNumber',
                             'nextSaleOrderNumber', 'nextChallanNumber', 'nextCreditNoteNumber',
                             'nextDebitNoteNumber', 'nextPaymentNumber', 'nextExpenseNumber',
                             'nextCommissionPayoutNumber', 'updatedAt'
                           ])
                         );
        // Deleting settings/profile is permitted by owner as step 1 of Google Play compliant account deletion
        allow delete: if isOwner(userId) && settingId == 'profile';
      }

      match /parties/{partyId} {
        allow get: if isOwner(userId) && isValidId(partyId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(partyId) &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'partyType', 'openingBalance', 'currentBalance',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'partyType', 'phone', 'email', 'gstin', 'stateName',
                           'billingAddress', 'shippingAddress', 'openingBalance', 'currentBalance',
                           'defaultAgentId', 'isActive', 'notes', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidParty(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(partyId) &&
                         isValidParty(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt && (
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'name', 'partyType', 'phone', 'email', 'gstin', 'stateName',
                             'billingAddress', 'shippingAddress', 'openingBalance', 'currentBalance',
                             'defaultAgentId', 'isActive', 'notes', 'updatedAt'
                           ]) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['currentBalance', 'updatedAt'])
                         );
        allow delete: if isOwner(userId) && isValidId(partyId);
      }

      match /items/{itemId} {
        allow get: if isOwner(userId) && isValidId(itemId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(itemId) &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'itemType', 'unit', 'salePrice', 'purchasePrice',
                           'taxRatePercent', 'currentStock', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'itemType', 'hsnSac', 'itemCode', 'category', 'unit',
                           'salePrice', 'salePriceWithTax', 'wholesalePrice', 'purchasePrice',
                           'discountPercent', 'taxRatePercent', 'commissionPercent',
                           'openingStock', 'currentStock', 'minStockLevel', 'location',
                           'isActive', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidItem(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(itemId) &&
                         isValidItem(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt && (
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'name', 'itemType', 'hsnSac', 'itemCode', 'category', 'unit',
                             'salePrice', 'salePriceWithTax', 'wholesalePrice', 'purchasePrice',
                             'discountPercent', 'taxRatePercent', 'commissionPercent',
                             'openingStock', 'currentStock', 'minStockLevel', 'location',
                             'isActive', 'updatedAt'
                           ]) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['currentStock', 'updatedAt'])
                         );
        allow delete: if isOwner(userId) && isValidId(itemId);
      }

      match /accounts/{accountId} {
        allow get: if isOwner(userId) && isValidId(accountId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(accountId) &&
                         incoming().keys().hasAll([
                           'userId', 'accountName', 'accountType', 'openingBalance',
                           'currentBalance', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'accountName', 'accountType', 'bankName', 'accountNumber',
                           'ifscCode', 'upiId', 'openingBalance', 'currentBalance',
                           'isActive', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidAccount(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(accountId) &&
                         isValidAccount(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt && (
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'accountName', 'accountType', 'bankName', 'accountNumber',
                             'ifscCode', 'upiId', 'openingBalance', 'currentBalance',
                             'isActive', 'updatedAt'
                           ]) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['currentBalance', 'updatedAt'])
                         );
        allow delete: if isOwner(userId) && isValidId(accountId);
      }

      match /agents/{agentId} {
        allow get: if isOwner(userId) && isValidId(agentId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(agentId) &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'agentType', 'openingBalance', 'currentBalance',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'agentType', 'phone', 'cityArea', 'upiId', 'bankDetails',
                           'defaultPercent', 'defaultPerUnitAmount', 'defaultBasis', 'defaultTrigger',
                           'openingBalance', 'currentBalance', 'totalEarned', 'totalPaid',
                           'isActive', 'notes', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidAgent(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(agentId) &&
                         isValidAgent(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt && (
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'name', 'agentType', 'phone', 'cityArea', 'upiId', 'bankDetails',
                             'defaultPercent', 'defaultPerUnitAmount', 'defaultBasis', 'defaultTrigger',
                             'openingBalance', 'currentBalance', 'totalEarned', 'totalPaid',
                             'isActive', 'notes', 'updatedAt'
                           ]) ||
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'currentBalance', 'totalEarned', 'totalPaid', 'updatedAt'
                           ])
                         );
        allow delete: if isOwner(userId) && isValidId(agentId);
      }

      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(transactionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         incoming().keys().hasAll([
                           'userId', 'txType', 'refNumber', 'dateMillis',
                           'totalAmount', 'paidAmount', 'balanceAmount', 'status',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'txType', 'refNumber', 'dateMillis', 'dueDateMillis',
                           'partyId', 'partyName', 'placeOfSupply', 'isInterState', 'category',
                           'paymentMode', 'accountId', 'toAccountId', 'linkedTxId', 'lineItems',
                           'subtotal', 'discountAmount', 'billDiscountAmount',
                           'extraChargesLabel', 'extraChargesAmount',
                           'cgstAmount', 'sgstAmount', 'igstAmount', 'taxAmount', 'roundOffAmount',
                           'totalAmount', 'paidAmount', 'balanceAmount', 'status',
                           'agentId', 'agentName', 'commissionBasis', 'commissionTrigger',
                           'commissionStatus', 'commissionRatePercent', 'commissionTotalAmount',
                           'commissionAccruedAmount', 'commissionSplits',
                           'tdsPercent', 'tdsAmount', 'cancelReason', 'cancelledAtMillis',
                           'notes', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidTransaction(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         existing().status != 'CANCELLED' &&
                         isValidTransaction(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt && (
                           // Action 1: Settlement payment & proportional commission accrual
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'paidAmount', 'balanceAmount', 'status',
                             'commissionAccruedAmount', 'commissionStatus', 'commissionSplits',
                             'updatedAt'
                           ]) ||
                           // Action 2: Convert Estimate / Sale Order / Delivery Challan to Sale Invoice
                           (incoming().status == 'CONVERTED' &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'status', 'linkedTxId', 'updatedAt'
                            ])) ||
                           // Action 3: Cancel voucher/invoice with reason & commission reversal
                           (incoming().status == 'CANCELLED' &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'status', 'cancelReason', 'cancelledAtMillis',
                              'commissionStatus', 'commissionAccruedAmount', 'commissionSplits',
                              'updatedAt'
                            ]))
                         );
        // Ledger immutability: transactions cannot be deleted while the user profile exists.
        // Only allowed during account deletion after settings/profile has been deleted.
        allow delete: if isOwner(userId) &&
                         !exists(/databases/$(database)/documents/users/$(userId)/settings/profile);
      }
    }
  }
}
