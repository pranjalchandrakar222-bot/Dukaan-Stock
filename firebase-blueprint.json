{
  "entities": {
    "BusinessProfile": {
      "title": "BusinessProfile",
      "description": "Store profile, GSTIN, per-type invoice numbering, UPI ID, and UI theme preference.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of owner" },
        "businessName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "gstin": { "type": "string" },
        "address": { "type": "string" },
        "stateName": { "type": "string" },
        "currencySymbol": { "type": "string" },
        "invoicePrefix": { "type": "string" },
        "nextInvoiceNumber": { "type": "integer" },
        "nextPurchaseNumber": { "type": "integer" },
        "nextEstimateNumber": { "type": "integer" },
        "nextSaleOrderNumber": { "type": "integer" },
        "nextChallanNumber": { "type": "integer" },
        "nextCreditNoteNumber": { "type": "integer" },
        "nextDebitNoteNumber": { "type": "integer" },
        "nextPaymentNumber": { "type": "integer" },
        "nextExpenseNumber": { "type": "integer" },
        "nextCommissionPayoutNumber": { "type": "integer" },
        "useFinancialYearPrefix": { "type": "boolean" },
        "upiId": { "type": "string" },
        "bankDetails": { "type": "string" },
        "invoiceTerms": { "type": "string" },
        "themeStyle": {
          "type": "string",
          "enum": ["DYNAMIC", "COBALT", "EMERALD", "TERRACOTTA", "SLATE"]
        },
        "stopNegativeStock": { "type": "boolean" },
        "roundOffTotal": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "businessName",
        "currencySymbol",
        "nextInvoiceNumber",
        "themeStyle",
        "stopNegativeStock",
        "roundOffTotal",
        "createdAt",
        "updatedAt"
      ]
    },
    "Party": {
      "title": "Party",
      "description": "Customer or supplier khata ledger account.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "partyType": { "type": "string", "enum": ["CUSTOMER", "SUPPLIER", "BOTH"] },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "gstin": { "type": "string" },
        "stateName": { "type": "string" },
        "billingAddress": { "type": "string" },
        "shippingAddress": { "type": "string" },
        "openingBalance": { "type": "number" },
        "currentBalance": { "type": "number" },
        "defaultAgentId": { "type": "string" },
        "isActive": { "type": "boolean" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "partyType", "openingBalance", "currentBalance", "createdAt", "updatedAt"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Product or service item with HSN/SAC, pricing, GST slab, commission %, and live stock tracking.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "itemType": { "type": "string", "enum": ["PRODUCT", "SERVICE"] },
        "hsnSac": { "type": "string" },
        "itemCode": { "type": "string" },
        "category": { "type": "string" },
        "unit": { "type": "string" },
        "salePrice": { "type": "number" },
        "salePriceWithTax": { "type": "boolean" },
        "wholesalePrice": { "type": "number" },
        "purchasePrice": { "type": "number" },
        "discountPercent": { "type": "number" },
        "taxRatePercent": { "type": "number" },
        "commissionPercent": { "type": "number" },
        "openingStock": { "type": "number" },
        "currentStock": { "type": "number" },
        "minStockLevel": { "type": "number" },
        "location": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "name",
        "itemType",
        "unit",
        "salePrice",
        "purchasePrice",
        "taxRatePercent",
        "currentStock",
        "createdAt",
        "updatedAt"
      ]
    },
    "CashBankAccount": {
      "title": "CashBankAccount",
      "description": "Cash register, bank account, or UPI wallet ledger.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "accountName": { "type": "string" },
        "accountType": { "type": "string", "enum": ["CASH", "BANK", "UPI"] },
        "bankName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "ifscCode": { "type": "string" },
        "upiId": { "type": "string" },
        "openingBalance": { "type": "number" },
        "currentBalance": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "accountName", "accountType", "openingBalance", "currentBalance", "createdAt", "updatedAt"]
    },
    "Agent": {
      "title": "Agent",
      "description": "Sales agent, mistri, technician, architect, or referral partner for commission tracking and payouts.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "agentType": { "type": "string", "enum": ["AGENT", "MISTRI", "SALESMAN", "ARCHITECT", "CONTRACTOR", "REFERRAL"] },
        "phone": { "type": "string" },
        "cityArea": { "type": "string" },
        "upiId": { "type": "string" },
        "bankDetails": { "type": "string" },
        "defaultPercent": { "type": "number" },
        "defaultPerUnitAmount": { "type": "number" },
        "defaultBasis": { "type": "string", "enum": ["TAXABLE", "TOTAL", "PROFIT", "PER_UNIT"] },
        "defaultTrigger": { "type": "string", "enum": ["ON_INVOICE", "ON_COLLECTION"] },
        "openingBalance": { "type": "number" },
        "currentBalance": { "type": "number" },
        "totalEarned": { "type": "number" },
        "totalPaid": { "type": "number" },
        "isActive": { "type": "boolean" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "agentType", "openingBalance", "currentBalance", "createdAt", "updatedAt"]
    },
    "BusinessTransaction": {
      "title": "BusinessTransaction",
      "description": "GST invoice, purchase bill, expense, estimate, order, commission payout, or audit adjustment voucher.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "txType": {
          "type": "string",
          "enum": [
            "SALE",
            "PAYMENT_IN",
            "ESTIMATE",
            "SALE_ORDER",
            "DELIVERY_CHALLAN",
            "CREDIT_NOTE",
            "PURCHASE",
            "PAYMENT_OUT",
            "EXPENSE",
            "PURCHASE_ORDER",
            "DEBIT_NOTE",
            "COMMISSION_PAYOUT",
            "CASH_TRANSFER",
            "CASH_ADJUSTMENT",
            "STOCK_ADJUSTMENT"
          ]
        },
        "refNumber": { "type": "string" },
        "dateMillis": { "type": "integer" },
        "dueDateMillis": { "type": "integer" },
        "partyId": { "type": "string" },
        "partyName": { "type": "string" },
        "placeOfSupply": { "type": "string" },
        "isInterState": { "type": "boolean" },
        "category": { "type": "string" },
        "paymentMode": { "type": "string", "enum": ["CASH", "UPI", "BANK_TRANSFER", "CARD", "CHEQUE"] },
        "accountId": { "type": "string" },
        "toAccountId": { "type": "string" },
        "linkedTxId": { "type": "string" },
        "lineItems": { "type": "array" },
        "subtotal": { "type": "number" },
        "discountAmount": { "type": "number" },
        "billDiscountAmount": { "type": "number" },
        "extraChargesLabel": { "type": "string" },
        "extraChargesAmount": { "type": "number" },
        "cgstAmount": { "type": "number" },
        "sgstAmount": { "type": "number" },
        "igstAmount": { "type": "number" },
        "taxAmount": { "type": "number" },
        "roundOffAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "balanceAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["PAID", "PARTIAL", "UNPAID", "OPEN", "CONVERTED", "CANCELLED"] },
        "agentId": { "type": "string" },
        "agentName": { "type": "string" },
        "commissionBasis": { "type": "string", "enum": ["TAXABLE", "TOTAL", "PROFIT", "PER_UNIT"] },
        "commissionTrigger": { "type": "string", "enum": ["ON_INVOICE", "ON_COLLECTION"] },
        "commissionStatus": { "type": "string", "enum": ["NONE", "ACCRUED", "PENDING_COLLECTION", "PARTIAL", "PAID", "REVERSED"] },
        "commissionRatePercent": { "type": "number" },
        "commissionTotalAmount": { "type": "number" },
        "commissionAccruedAmount": { "type": "number" },
        "commissionSplits": { "type": "array" },
        "tdsPercent": { "type": "number" },
        "tdsAmount": { "type": "number" },
        "cancelReason": { "type": "string" },
        "cancelledAtMillis": { "type": "integer" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "txType",
        "refNumber",
        "dateMillis",
        "totalAmount",
        "paidAmount",
        "balanceAmount",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/BusinessProfile" },
      "description": "Business settings document (docId: profile)"
    },
    "/users/{userId}/parties/{partyId}": {
      "schema": { "$ref": "#/entities/Party" },
      "description": "User-owned customer and supplier party ledgers"
    },
    "/users/{userId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "User-owned inventory products and services"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/CashBankAccount" },
      "description": "User-owned cash registers, bank accounts, and UPI wallets"
    },
    "/users/{userId}/agents/{agentId}": {
      "schema": { "$ref": "#/entities/Agent" },
      "description": "User-owned agents, mistris, technicians, and referral partner commission ledgers"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/BusinessTransaction" },
      "description": "User-owned sales, purchases, expenses, estimates, commission payouts, and audit vouchers"
    }
  }
}
